# Settings for apps/server. Copy to .env; every line here is also the default,
# so an empty .env works for local development.
#
# Each variable is a field of `Settings` in src/gov_mine/config.py, upper-cased
# with the GOV_MINE_ prefix. Durations take ISO 8601 ("P7D", "PT15M") or seconds.

# --- App ---------------------------------------------------------------------

GOV_MINE_APP_NAME="gov-mine API"
# Level for the app's own loggers.
GOV_MINE_LOG_LEVEL="INFO"
# "text" (timestamp, level, logger, request ID, message) for a terminal, or
# "json" (one object per line, the same fields) for a log collector. Every
# line carries the request ID, and the API logs one line per request.
GOV_MINE_LOG_FORMAT="text"
# Set a Logfire write token to send requests, SQL, jobs, and logs to
# https://logfire.pydantic.dev. Unset: telemetry is off. See src/gov_mine/shared/telemetry.py.
# GOV_MINE_LOGFIRE_TOKEN=""
# Shown in Logfire to tell deployments apart.
GOV_MINE_LOGFIRE_ENVIRONMENT="development"

# --- Database ----------------------------------------------------------------

# The PostgreSQL from compose.yaml (`vp run db:up`).
GOV_MINE_DATABASE_URL="postgresql+psycopg://gov_mine:gov_mine@localhost:5432/gov_mine"
# Log every SQL statement.
GOV_MINE_DATABASE_ECHO=false
# Connections each process keeps open, and how many more it may open under load.
GOV_MINE_DATABASE_POOL_SIZE=5
GOV_MINE_DATABASE_MAX_OVERFLOW=10
# PostgreSQL cancels any statement that runs longer than this.
GOV_MINE_DATABASE_STATEMENT_TIMEOUT="PT30S"

# --- Object storage ----------------------------------------------------------

# "s3" covers every S3-compatible service. See src/gov_mine/integrations/storage.
GOV_MINE_STORAGE_PROVIDER="s3"
GOV_MINE_STORAGE_BUCKET="gov-mine"
# The RustFS from compose.yaml. For AWS S3 itself set this to null.
GOV_MINE_STORAGE_ENDPOINT_URL="http://127.0.0.1:9000"
# Where the browser reaches storage, when that differs from the address above
# (the API inside Docker, the browser outside). Presigned URLs use it.
# GOV_MINE_STORAGE_PUBLIC_ENDPOINT_URL="http://localhost:9000"
GOV_MINE_STORAGE_REGION="us-east-1"
GOV_MINE_STORAGE_ACCESS_KEY="rustfsadmin"
GOV_MINE_STORAGE_SECRET_KEY="rustfsadmin"
# true: host/bucket/key URLs (RustFS, MinIO). false: bucket.host/key (AWS).
GOV_MINE_STORAGE_PATH_STYLE=true
# How long an upload or download URL stays valid.
GOV_MINE_STORAGE_URL_TTL="PT15M"

# --- Background jobs ---------------------------------------------------------

# The queue is in the database above (src/gov_mine/jobs); `gov-mine worker`
# runs the jobs. How many one worker process runs at a time.
GOV_MINE_JOBS_CONCURRENCY=2

# --- AI --------------------------------------------------------------------

# Every model goes through OpenRouter (https://openrouter.ai) with one key
# (src/gov_mine/integrations/ai). Unset: nothing calls a model.
# GOV_MINE_OPENROUTER_API_KEY=""
# OpenRouter model ids; each must be in the price list (src/gov_mine/modules/ledger/prices.py).
# The extraction (and OCR) model, through Pydantic AI.
GOV_MINE_EXTRACT_MODEL="openai/gpt-6-luna"
# The page classifier, through OpenRouter's Decisions API.
GOV_MINE_CLASSIFY_MODEL="typesafe/jev-1.14"
# The extraction model's reasoning: none, minimal, low, medium, high, or xhigh.
GOV_MINE_EXTRACT_REASONING_EFFORT="medium"
