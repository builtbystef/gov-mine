          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Read Root"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AICallOutput": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "crawl_run_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crawl Run Id"
          },
          "classification_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classification Id"
          },
          "extraction_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extraction Id"
          },
          "purpose": {
            "$ref": "#/components/schemas/AIPurpose"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "cost": {
            "type": "string",
            "title": "Cost"
          },
          "reported_cost": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Cost"
          },
          "price_list_version": {
            "type": "string",
            "title": "Price List Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "crawl_run_id",
          "classification_id",
          "extraction_id",
          "purpose",
          "provider",
          "model",
          "input_tokens",
          "output_tokens",
          "cost",
          "reported_cost",
          "price_list_version",
          "created_at"
        ],
        "title": "AICallOutput",
        "description": "One paid call. `cost` is from the price list; `reported_cost` is what OpenRouter said."
      },
      "AIPurpose": {
        "type": "string",
        "enum": [
          "classify",
          "extract",
          "ocr",
          "transcribe"
        ],
        "title": "AIPurpose"
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "purchase_order",
          "meeting_minutes",
          "budget",
          "procurement_guidelines",
          "youtube",
          "rfp",
          "grants",
          "press_releases",
          "projects",
          "project_material",
          "annual_report",
          "strategic_plan",
          "staff_directory"
        ],
        "title": "DocumentType",
        "description": "What a source lists and what a document is. A `project_material` is assigned by a\nproject's extraction, never by the classifier."
      },
      "DocumentTypeCount": {
        "properties": {
          "document_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "document_type",
          "count"
        ],
        "title": "DocumentTypeCount"
      },
      "FetchOutcome": {
        "type": "string",
        "enum": [
          "fetched",
          "not_modified",
          "unchanged",
          "blocked_robots",
          "skipped_scope",
          "skipped_type",
          "skipped_size",
          "skipped_depth",
          "failed_http",
          "failed_timeout"
        ],
        "title": "FetchOutcome"
      },
      "FetchOutput": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "webpage_id": {
            "type": "string",
            "format": "uuid",
            "title": "Webpage Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Requested At"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "outcome": {
            "$ref": "#/components/schemas/FetchOutcome"
          },
          "http_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Http Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "snapshot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SnapshotSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "webpage_id",
          "url",
          "requested_at",
          "duration_ms",
          "outcome",
          "http_status",
          "reason",
          "snapshot"
        ],
        "title": "FetchOutput",
        "description": "One attempt at a URL. `snapshot` is the copy it wrote, if it wrote one."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Page_AICallOutput_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AICallOutput"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "Page[AICallOutput]"
      },
      "Page_FetchOutput_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FetchOutput"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "Page[FetchOutput]"
      },
      "Page_RunOutput_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunOutput"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "Page[RunOutput]"
      },
      "Page_SourceOutput_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceOutput"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "Page[SourceOutput]"
      },
      "RunOutput": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "institution_id": {
            "type": "string",
            "format": "uuid",
            "title": "Institution Id"
          },
          "institution_name": {
            "type": "string",
            "title": "Institution Name"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "settings": {
            "$ref": "#/components/schemas/RunSettings"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "institution_id",
          "institution_name",
          "status",
          "settings",
          "started_at",
          "finished_at",
          "error",
          "created_at"
        ],
        "title": "RunOutput"
      },
      "RunSettings": {
        "properties": {
          "trigger": {
            "type": "string",
            "enum": [
              "cli",
              "dashboard",
              "scheduled"
            ],
            "title": "Trigger"
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "incremental"
            ],
            "title": "Mode"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "max_file_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max File Bytes"
          },
          "extractors": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extractors"
          }
        },
        "type": "object",
        "required": [
          "trigger",
          "mode"
        ],
        "title": "RunSettings",
        "description": "What a run was asked to do, kept on the run so two runs can be compared."
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "finished",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus"
      },
      "SnapshotSummary": {
        "properties": {
          "id": {
